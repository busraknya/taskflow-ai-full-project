// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

/// Kinds of task lifecycle events recorded for ML (see TaskEvent).
enum TaskEventType {
  CREATED
  SNAPSHOT
  STATUS_CHANGED
  DUE_DATE_CHANGED
  ASSIGNEE_CHANGED
  PRIORITY_CHANGED
  COMMENT_ADDED
  COMMENT_DELETED
}

/// API: written with the change. OFFLINE_SYNC: change made offline on a client.
/// BACKFILL: reconstructed from audit history when TaskEvent was introduced.
enum TaskEventSource {
  API
  OFFLINE_SYNC
  BACKFILL
}

/// Outcome of a workspace risk-model training run.
enum RiskTrainingStatus {
  QUEUED
  RUNNING
  PROMOTED
  REJECTED
  NOT_READY
  FAILED
}

enum RiskTrainingTrigger {
  SCHEDULED
  MANUAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  UNAVAILABLE
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  // Set to block authentication without deleting the account.
  disabledAt        DateTime?
  // Access tokens issued before this instant are rejected.
  passwordChangedAt DateTime?

  memberships       WorkspaceMembership[]
  assignedTasks     Task[]              @relation("TaskAssignee")
  comments          Comment[]
  refreshTokens     RefreshToken[]
  notificationPrefs NotificationPreference[]
  sentWorkspaceInvitations WorkspaceMembership[] @relation("WorkspaceInviter")
  invitationsSent     WorkspaceInvitation[] @relation("InvitationInviter")
  invitationsAccepted WorkspaceInvitation[] @relation("InvitationAcceptor")

  @@index([email])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 (hex) of the opaque refresh token; the raw token is never stored.
  tokenHash  String   @unique
  // All tokens produced by rotation from one login share a family.
  familyId   String?
  // Set when this token was rotated (as opposed to revoked by logout/reuse).
  replacedByTokenId String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([familyId])
}

model Workspace {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique
  /// IANA time zone; date-only due dates end at midnight in this zone.
  timezone  String    @default("UTC")
  /// Risk-model training runs only after an owner/admin enables it.
  riskTrainingEnabled   Boolean   @default(false)
  riskTrainingEnabledAt DateTime?
  /// Latest readiness report (computed nightly and when training is enabled).
  riskReadiness         Json?
  riskReadinessAt       DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  memberships WorkspaceMembership[]
  projects    Project[]
  auditLogs   AuditLogEntry[]
  taskEvents  TaskEvent[]
  riskTrainingRuns RiskModelTraining[]
  invitations      WorkspaceInvitation[]

  @@index([slug])
}

model WorkspaceMembership {
  id          String            @id @default(uuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?              @relation("WorkspaceInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  role        WorkspaceRole
  status      MembershipStatus  @default(PENDING)
  invitedById String?
  invitedAt   DateTime          @default(now())
  invitationExpiresAt DateTime?
  joinedAt    DateTime?

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([invitedById])
  @@index([userId, status, invitationExpiresAt])
  @@index([workspaceId, status, invitationExpiresAt])
}

/// Invitation to an email address, accepted with a single-use link. Works for
/// addresses with or without an account; only the token's SHA-256 is stored.
/// At most one open invitation per (workspace, email) is enforced by a partial
/// unique index in the migration.
model WorkspaceInvitation {
  id           String        @id @default(uuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Normalised (trimmed, lower-case).
  email        String
  role         WorkspaceRole
  tokenHash    String        @unique
  invitedById  String?
  invitedBy    User?         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?         @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?

  @@index([workspaceId, email])
  @@index([invitedById])
  @@index([acceptedById])
}

model Project {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tasks Task[]

  @@index([workspaceId])
}

model Task {
  id           String     @id @default(uuid())
  workspaceId  String
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  priority     Int        @default(0)
  position     Int        @default(0)
  assigneeId   String?
  assignee     User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  /// True when dueDate is a calendar date (stored as UTC midnight of that date).
  dueDateIsDateOnly Boolean    @default(false)
  /// Time of the last transition to DONE; cleared when the task is reopened.
  completedAt       DateTime?
  parentTaskId String?
  parentTask   Task?      @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks     Task[]     @relation("SubTasks")
  version      Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  archivedAt   DateTime?
  deletedAt    DateTime?

  comments        Comment[]
  riskAssessments RiskAssessment[]
  events          TaskEvent[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([workspaceId, status])
}

model Comment {
  id         String    @id @default(uuid())
  taskId     String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([taskId])
}

/// Append-only task lifecycle history, written in the same transaction as the
/// task change it describes. Source of truth for ML features and labels.
model TaskEvent {
  id               String          @id @default(uuid())
  /// Total order of events, including events written in one transaction.
  seq              BigInt          @unique @default(autoincrement())
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId           String
  task             Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type             TaskEventType
  oldValue         Json?
  newValue         Json?
  /// Server time (UTC) at which the change was stored.
  occurredAt       DateTime
  /// Client-reported time for changes made offline; informational only.
  clientOccurredAt DateTime?
  actorId          String?
  source           TaskEventSource @default(API)

  @@index([workspaceId, taskId, occurredAt])
  @@index([workspaceId, occurredAt])
}

model AuditLogEntry {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String
  entityType  String
  entityId    String
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([entityType, entityId])
}

model RiskAssessment {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  riskLevel   RiskLevel
  riskScore   Float?
  factors     Json
  modelVersion String
  computedAt  DateTime  @default(now())
  /// Feature contract used for this assessment (null for legacy rows).
  featureSpecVersion String?
  /// Exact feature values sent to the model, for audit and retraining checks.
  featureSnapshot    Json?
  /// Why no level is available (riskLevel UNAVAILABLE), e.g. "done", "overdue".
  reason             String?

  @@index([taskId])
  @@index([computedAt])
}

/// One training attempt for a workspace's risk model.
model RiskModelTraining {
  id             String              @id @default(uuid())
  workspaceId    String
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trigger        RiskTrainingTrigger
  status         RiskTrainingStatus  @default(QUEUED)
  requestedById  String?
  /// Labelled tasks available when the run started.
  labelableTasks Int?
  readiness      Json?
  /// Evaluation report from the ML service (metrics, gates, data window).
  report         Json?
  modelVersion   String?
  error          String?
  createdAt      DateTime            @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([workspaceId, createdAt])
}

model NotificationPreference {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String
  emailEnabled  Boolean @default(true)
  pushEnabled   Boolean @default(false)

  @@unique([userId, category])
}
