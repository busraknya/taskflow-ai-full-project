# Copy to .env for local development. Replace every sample value before deployment.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace_with_a_unique_database_password
POSTGRES_DB=taskflow
DATABASE_URL=postgresql://taskflow:replace_with_a_unique_database_password@postgres:5432/taskflow?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
# Used by the backend queue and rate limiter. When set, docker-compose starts
# Redis with requirepass; empty means no Redis authentication (local use only).
# Set it in every deployed environment.
REDIS_PASSWORD=

JWT_SECRET=replace_with_at_least_32_random_bytes
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
# Exact number of trusted reverse proxies in front of the backend that append to
# X-Forwarded-For (integer 0-10, checked at startup). Keep 0 when the backend is
# reached directly. Too high a value lets clients spoof their IP and bypass
# per-IP rate limits. See "Reverse proxy and client IP" in README.md.
TRUST_PROXY_HOPS=0

ML_SERVICE_URL=http://ml-service:8000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public web-app URL; invitation emails link to <FRONTEND_URL>/workspaces.
# Must be an absolute http(s) URL, otherwise the link is left out of the email.
FRONTEND_URL=http://localhost:3000

# Optional email delivery. Leave SMTP_HOST empty to disable email entirely
# (no mail server is contacted; invitation links are shared manually).
# Local testing: docker compose --profile dev-mail up -d, then SMTP_HOST=mailpit, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: risk-model readiness and training schedule. Defaults are starting
# hypotheses (see ml-service/MODEL_CARD.md), not proven requirements.
# RISK_READINESS_MIN_TASKS=300
# RISK_READINESS_MIN_PER_CLASS=50
# RISK_READINESS_MIN_MINORITY_SHARE=0.05
# RISK_READINESS_MIN_SPAN_DAYS=90
# RISK_READINESS_MIN_TEST_TASKS=250
# RISK_READINESS_MIN_TEST_MINORITY=20
# RISK_READINESS_MIN_GROUPS=3
# RISK_TRAINING_MIN_DAYS=30
# RISK_TRAINING_MIN_GROWTH=0.2
